{
  "name": "fantasion-backend",
  "private": true,
  "version": "1.5.0",
  "description": "Backend for fantasion website",
  "keywords": [
    "web",
    "django",
    "api",
    "rest"
  ],
  "author": "Pavel Žák <pavel@zak.global>",
  "homepage": "https://fantasion.cz",
  "license": "MIT",
  "directories": {},
  "files": [],
  "scripts": {
    "build": "npm run build:messages && npm run build:py && npm run build:requirements",
    "build:py": "uv build --sdist",
    "build:messages": "uv run python ./manage.py compilemessages",
    "build:requirements": "uv export --no-hashes --no-emit-project -o requirements.txt",
    "collectstatic": "uv run python ./manage.py collectstatic --no-input",
    "db:seed": "uv run python ./manage.py create_test_data",
    "dev": "uv run python ./manage.py runserver",
    "lint": "uv run flake8",
    "migrate": "uv run python ./manage.py migrate",
    "shell": "uv run python ./manage.py shell",
    "python-install": "uv sync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-paja/fantasion.git"
  },
  "bugs": {
    "url": "https://github.com/just-paja/fantasion/issues"
  }
}
